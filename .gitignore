# Remove these lines if working in a team
package.json
package-lock.json
yarn.lock
pnpm-lock.yaml

# ===== Logs =====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===== Runtime data =====
pids/
*.pid
*.seed

# ===== Build output =====
dist/
build/
out/

# ===== Cache =====
.cache/
.npm/
.eslintcache
coverage/

# ===== OS / Editor junk =====
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ===== Secrets & keys =====
*.pem
*.key
*.crt
*.pfx

# ===== Docker =====
docker-compose.override.yml

# ===== Temporary files =====
tmp/
temp/
